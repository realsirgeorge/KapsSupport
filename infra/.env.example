# Copy this file to .env in the same directory (infra/) and fill in real values.
# .env itself must NEVER be committed — add it to .gitignore before it's created.
# This is local-dev secrets management (ARCHITECTURE_REVIEW.md §1.5/2.1 flagged this
# needs to graduate to a real secrets manager before any shared/hosted environment —
# this file is the honest starting point, not the end state).

# --- Postgres ---
POSTGRES_DB=support_ticketing
POSTGRES_USER=support_app
POSTGRES_PASSWORD=change_me_generate_a_real_secret
# Full connection string the api/worker services actually use:
DATABASE_URL=postgresql://support_app:change_me_generate_a_real_secret@postgres:5432/support_ticketing

# --- Redis ---
REDIS_PASSWORD=change_me_generate_a_real_secret
REDIS_URL=redis://:change_me_generate_a_real_secret@redis:6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me_generate_a_real_secret
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ticket-attachments

# --- Auth ---
SESSION_SECRET=change_me_generate_a_long_random_secret
CSRF_SECRET=change_me_generate_a_different_long_random_secret
# SSO — leave blank to disable a provider (FR-12.2: local + SSO both supported, not exclusive)
SSO_AZURE_AD_CLIENT_ID=
SSO_AZURE_AD_CLIENT_SECRET=
SSO_AZURE_AD_TENANT_ID=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_OKTA_CLIENT_ID=
SSO_OKTA_CLIENT_SECRET=
SSO_OKTA_DOMAIN=

# --- SMTP (outbound notifications, FR-5.x) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SupportDesk <no-reply@yourcompany.com>"

# --- App-level config ---
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_INTERNAL_URL=http://api:3001        # used by web (SSR) for server-to-server calls
NEXT_PUBLIC_API_URL=https://localhost   # used by browser-side code, goes through nginx
# No AUTO_CLOSE_DAYS — tickets in Pending Confirmation never auto-close, by design (REQUIREMENTS.md §4.9)
