# Copy this file to .env in the same directory (infra/) and fill in real values.
# .env itself must NEVER be committed — it's gitignored.
#
# This was rewritten to match what the code actually reads (grep for
# `process.env.` in api/src and worker/src if you want to verify). An earlier
# version of this file, written before any of the services existed, described
# a DATABASE_URL/REDIS_URL/MINIO_ENDPOINT shape that the API and worker never
# implemented — they read individual HOST/PORT/USER/PASSWORD vars instead.
# Following the old file would have produced a container that starts and then
# fails every DB call. See ../SETUP.md for the full walkthrough.

# --- Postgres ---
# POSTGRES_DB/USER/PASSWORD configure the postgres container itself.
# DATABASE_* is what the api and worker services connect with — same
# credentials, different variable names, both required.
POSTGRES_DB=support_ticketing
POSTGRES_USER=support_app
POSTGRES_PASSWORD=change_me_generate_a_real_secret

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=support_ticketing
DATABASE_USER=support_app
DATABASE_PASSWORD=change_me_generate_a_real_secret

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_generate_a_real_secret

# --- MinIO (S3-compatible object storage, ticket attachments) ---
# MINIO_HOST defaults to "localhost" in code if unset — that default is wrong
# for every container in this compose file and must be overridden to "minio".
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me_generate_a_real_secret
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=ticket-attachments

# --- Auth ---
# JWT_SECRET signs the session cookie. If this is left unset the API falls
# back to the literal string "dev-secret" — every session it issues would be
# forgeable by anyone who reads the source. Generate a real one:
#   openssl rand -hex 32
JWT_SECRET=change_me_generate_a_real_secret

# SESSION_SECRET / CSRF_SECRET are referenced in earlier design docs but not
# read anywhere in the current api/worker source — left here as placeholders
# in case that changes, not required for the app to run today.
SESSION_SECRET=change_me_generate_a_long_random_secret
CSRF_SECRET=change_me_generate_a_different_long_random_secret

# SSO / SMTP: designed for (see REQUIREMENTS.md), not implemented in the
# current codebase — nothing reads these yet. Safe to leave blank.
SSO_AZURE_AD_CLIENT_ID=
SSO_AZURE_AD_CLIENT_SECRET=
SSO_AZURE_AD_TENANT_ID=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_OKTA_CLIENT_ID=
SSO_OKTA_CLIENT_SECRET=
SSO_OKTA_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SupportDesk <no-reply@yourcompany.com>"

# --- App-level config ---
NODE_ENV=production
API_PORT=3001
WEB_PORT=3000
# Browser-facing API URL — goes through nginx, not directly to the api
# container. Change to your real domain once you have TLS in front of nginx.
NEXT_PUBLIC_API_URL=http://localhost/v1
# CORS allow-list on the API side — must match wherever the web app is served from.
FRONTEND_URL=http://localhost
